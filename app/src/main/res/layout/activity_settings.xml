<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/tinol_blue"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Device Status Card -->
        <LinearLayout
            android:id="@+id/layout_device_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card_limited"
            android:layout_marginBottom="24dp">
            
            <TextView
                android:id="@+id/tv_device_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_status"
                android:textStyle="bold"
                android:textColor="@color/white" />
            
            <TextView
                android:id="@+id/tv_device_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/limited_warning"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:layout_marginTop="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- System Prompt -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/system_prompt"
            android:textStyle="bold"
            android:textColor="@color/tinol_blue" />
        <EditText
            android:id="@+id/edit_system_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top"
            android:hint="You are a helpful assistant."
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Temperature -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/temp"
            android:textStyle="bold"
            android:textColor="@color/tinol_blue" />
        <EditText
            android:id="@+id/edit_temp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="0.8"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Top-P -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/top_p"
            android:textStyle="bold"
            android:textColor="@color/tinol_blue" />
        <EditText
            android:id="@+id/edit_top_p"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="0.95"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Top-K -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/top_k"
            android:textStyle="bold"
            android:textColor="@color/tinol_blue" />
        <EditText
            android:id="@+id/edit_top_k"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="40"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Context Size -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/context_size"
            android:textStyle="bold"
            android:textColor="@color/tinol_blue" />
        <EditText
            android:id="@+id/edit_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="512"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="@color/tinol_blue"
            android:textColor="@color/white"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>
